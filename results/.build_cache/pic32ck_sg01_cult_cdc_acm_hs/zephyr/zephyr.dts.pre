/ {
 model = "PIC32CK SG01 Curiosity Ultra";
 compatible = "microchip,pic32ck_sg01_cult";

 chosen {
  zephyr,sram = &sram0;
  zephyr,flash = &flash0;
  zephyr,flash-controller = &nvmctrl;
  zephyr,code-partition = &slot0_partition;
  zephyr,console = &sercom5;
  zephyr,shell-uart = &sercom5;
  zephyr,canbus = &can0;
  zephyr,entropy = &trng;
  zephyr,sdhc = &sdhc0;
 };

 aliases {
  led0 = &led0;
  led1 = &led1;
  sw0 = &button0;
  sw1 = &button1;
  spi0 = &sercom2;
  i2c0 = &sercom4;
  sdhc0 = &sdhc0;
 };

 leds {
  compatible = "gpio-leds";

  led0: led_0 {
   gpios = <&portd_secure 20 (1 << 0)>;
   label = "LED0";
  };

  led1: led_1 {
   gpios = <&portb_secure 25 (1 << 0)>;
   label = "LED1";
  };
 };

 buttons {
  compatible = "gpio-keys";

  button0: button_0 {
   gpios = <&portb_secure 26 ((1 << 4) | (1 << 0))>;
   label = "SW0";
   zephyr,code = <11>;
  };

  button1: button_1 {
   gpios = <&portd_secure 2 ((1 << 4) | (1 << 0))>;
   label = "SW1";
   zephyr,code = <2>;
  };
 };
};

&flash0 {
 partitions {
  #address-cells = <1>;
  #size-cells = <1>;
  ranges;
# 88 "D:/ZephyrProject/mchp_zephyrproject/zephyr/boards/microchip/pic32c/pic32ck_sg01_cult/pic32ck_sg01_cult.dts"
  boot_partition: partition@0 {
   compatible = "zephyr,mapped-partition";
   label = "mcuboot";
   reg = <0x00000000 ((128) * 1024)>;
  };


  slot0_partition: partition@4000000 {
   compatible = "zephyr,mapped-partition";
   label = "image-0";
   reg = <0x04000000 ((1008) * 1024)>;
  };


  slot1_partition: partition@40fc000 {
   compatible = "zephyr,mapped-partition";
   label = "image-1";
   reg = <0x040fc000 ((1008) * 1024)>;
  };


  storage_partition: partition@41f8000 {
   compatible = "zephyr,mapped-partition";
   label = "storage";
   reg = <0x041f8000 ((32) * 1024)>;
  };
 };
};

&cpu0 {
 clock-frequency = <120000000>;
};

&clock {
 compatible = "microchip,pic32ck-sg-gc-clock";

 xosc: xosc {
  compatible = "microchip,pic32ck-sg-gc-xosc";
  xosc-enable = <1>;
  xosc-xtal-en = <1>;
  xosc-auto-gain-control-loop-en = <0>;
  xosc-clock-switch-back-en = <0>;
  xosc-frequency = <12000000>;
  xosc-on-demand-en = <0>;
  xosc-startup-time = <500000>;
  xosc-clock-failure-detection-en = <0>;
  xosc-safe-clock-frequency = <48>;
  xosc-usbhs-ref-clock-div = "usbhs-pll-ref-xosc-clock-div-1";
 };

 xosc32k: xosc32k {
  compatible = "microchip,pic32ck-sg-gc-xosc32k";
  xosc32k-enable = <1>;
  xosc32k-xtal-en = <1>;
  xosc32k-frequency = <32768>;
  xosc32k-on-demand-en = <0>;
  xosc32k-control-gain-mode = "lower-gain-mode-value";
  xosc32k-servo-loop-en = <1>;
  xosc32k-gain-boost = <1>;
  xosc32k-startup-time = <1000>;
  xosc32k-rtc-clk-selection-en = <1>;
  xosc32k-cfd-en = <0>;
  xosc32k-cfd-prescaler = <0>;
  xosc32k-cfd-switchback-en = <0>;
 };

 dfll48m: dfll48m {
  compatible = "microchip,pic32ck-sg-gc-dfll48m";
  dfll48m-src-gclk = "gclk1";
  dfll48m-enable = <1>;
  dfll48m-closed-loop-en = <0>;
  dfll48m-on-demand-en = <1>;
  dfll48m-usb-clock-recovery-mode = <1>;
  dfll48m-wait-lock-en = <1>;
  dfll48m-quick-lock-dis = <1>;
  dfll48m-chill-cycle-dis = <1>;
  dfll48m-lose-lock-en = <1>;
  dfll48m-stable-freq-en = <1>;
  dfll48m-tune-max-step = <1>;
  dfll48m-multiply-factor = <1>;
 };

 pll: pll {
  compatible = "microchip,pic32ck-sg-gc-pll";

  pll0: pll0 {
   compatible = "microchip,pic32ck-sg-gc-pllchild";

   subsystem = <(((2) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((0) << 8) | 0)>;
   pll-enable = <1>;
   pll-on-demand-en = <0>;
   pll-bandwidth-sel = "bwsel-1";
   pll-src = "xosc";
   pll-ref-division-factor = <3>;
   pll-feedback-divider-factor = <300>;
   pll-freq-division-factor-int = <0>;
   pll-freq-division-factor-rem = <0>;

   pll0out0: pll0out0 {
    subsystem = <(((3) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((0x3f) << 8) | 0)>;
    pll-output-division-factor = <10>;
    pll-output-en = <1>;
   };

   pll0out1: pll0out1 {
    subsystem = <(((3) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((0x3f) << 8) | 1)>;
    pll-output-division-factor = <25>;
    pll-output-en = <1>;
   };

   pll0out2: pll0out2 {
    subsystem = <(((3) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((0x3f) << 8) | 2)>;
    pll-output-division-factor = <12>;
    pll-output-en = <1>;
   };

   pll0out3: pll0out3 {
    subsystem = <(((3) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((0x3f) << 8) | 3)>;
    pll-output-division-factor = <8>;
    pll-output-en = <0>;
   };

   pll0out4: pll0out4 {
    subsystem = <(((3) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((0x3f) << 8) | 4)>;
    pll-output-division-factor = <8>;
    pll-output-en = <0>;
   };

   pll0out5: pll0out5 {
    subsystem = <(((3) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((0x3f) << 8) | 5)>;
    pll-output-division-factor = <8>;
    pll-output-en = <0>;
   };
  };
 };

 gclkgen: gclkgen {
  compatible = "microchip,pic32ck-sg-gc-gclkgen";

  gclkgen0 {
   subsystem = <(((6) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((0x3f) << 8) | 0)>;
   gclkgen-en = <1>;
   gclkgen-run-in-standby-en = <0>;
   gclkgen-ext-input-frequency = <0>;
   gclkgen-src = "pll0_0";
   gclkgen-output-off-val = "logic-level-0";
   gclkgen-input-frequency = <0>;
   gclkgen-div-select = "div-factor";
   gclkgen-div-factor = <1>;
   gclkgen-duty-50-50-en = <0>;
   gclkgen-out-clock-signal = <0>;
  };

  gclkgen1 {
   subsystem = <(((6) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((0x3f) << 8) | 1)>;
   gclkgen-en = <1>;
   gclkgen-run-in-standby-en = <0>;
   gclkgen-ext-input-frequency = <0>;
   gclkgen-src = "pll0_0";
   gclkgen-output-off-val = "logic-level-0";
   gclkgen-input-frequency = <0>;
   gclkgen-div-select = "div-factor";
   gclkgen-div-factor = <2>;
   gclkgen-duty-50-50-en = <0>;
   gclkgen-out-clock-signal = <0>;
  };


  gclkgen2 {
   subsystem = <(((6) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((0x3f) << 8) | 2)>;
   gclkgen-en = <1>;
   gclkgen-run-in-standby-en = <0>;
   gclkgen-ext-input-frequency = <0>;
   gclkgen-src = "pll0_1";
   gclkgen-output-off-val = "logic-level-0";
   gclkgen-input-frequency = <0>;
   gclkgen-div-select = "div-factor";
   gclkgen-div-factor = <1>;
   gclkgen-duty-50-50-en = <0>;
   gclkgen-out-clock-signal = <0>;
  };


  gclkgen3 {
   subsystem = <(((6) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((0x3f) << 8) | 3)>;
   gclkgen-en = <1>;
   gclkgen-run-in-standby-en = <0>;
   gclkgen-ext-input-frequency = <0>;
   gclkgen-src = "pll0_2";
   gclkgen-output-off-val = "logic-level-0";
   gclkgen-input-frequency = <0>;
   gclkgen-div-select = "div-factor";
   gclkgen-div-factor = <1>;
   gclkgen-duty-50-50-en = <0>;
   gclkgen-out-clock-signal = <0>;
  };


  gclkgen4 {
   subsystem = <(((6) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((0x3f) << 8) | 4)>;
   gclkgen-en = <1>;
   gclkgen-run-in-standby-en = <0>;
   gclkgen-ext-input-frequency = <0>;
   gclkgen-src = "xosc";
   gclkgen-output-off-val = "logic-level-0";
   gclkgen-input-frequency = <0>;
   gclkgen-div-select = "div-factor";
   gclkgen-div-factor = <1>;
   gclkgen-duty-50-50-en = <0>;
   gclkgen-out-clock-signal = <0>;
  };
 };

 gclkperiph: gclkperiph {
  compatible = "microchip,pic32ck-sg-gc-gclkperiph";
  #clock-cells = <1>;

  can0 {
   subsystem = <(((7) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((39) << 8) | 48)>;
   gclkperiph-src = "gclk0";
   gclkperiph-en = <1>;
  };

  usb0 {
   subsystem = <(((7) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((46) << 8) | 55)>;
   gclkperiph-src = "gclk2";
   gclkperiph-en = <1>;
  };

  sdhc0 {
   subsystem = <(((7) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((44) << 8) | 53)>;
   gclkperiph-src = "gclk3";
   gclkperiph-en = <1>;
  };

  sdhc0_slow {
   subsystem = <(((7) << 26) | ((0x3f) << 20) | ((0x3f) << 14) | ((18) << 8) | 16)>;
   gclkperiph-src = "gclk4";
   gclkperiph-en = <1>;
  };
 };

 mclkcpu: mclkcpu {
  compatible = "microchip,pic32ck-sg-gc-mclkcpu";
  mclk-div = "DIV1";
 };

 mclkperiph: mclkperiph {
  compatible = "microchip,pic32ck-sg-gc-mclkperiph";
  #clock-cells = <1>;

  usb0 {
   subsystem = <(((9) << 26) | ((3) << 20) | ((17) << 14) | ((0x3f) << 8) | 62)>;
   mclk-en = <1>;
  };

  usbhs0 {
   subsystem = <(((9) << 26) | ((0) << 20) | ((20) << 14) | ((0x3f) << 8) | 14)>;
   mclk-en = <1>;
  };

  sdhc0 {
   subsystem = <(((9) << 26) | ((0) << 20) | ((17) << 14) | ((0x3f) << 8) | 11)>;
   mclk-en = <1>;
  };
 };
};

&tcc1 {
 compatible = "microchip,tcc-g1-counter";
 max-bit-width = <32>;
 prescaler = <8>;
 status = "okay";
};

&portb_secure {
 status = "okay";
};

&portd_secure {
 status = "okay";
};

&sercom4 {
 compatible = "microchip,sercom-g1-i2c";
 #address-cells = <1>;
 #size-cells = <0>;
 clock-frequency = <400000>;
 pinctrl-0 = <&sercom4_i2c_default>;
 pinctrl-names = "default";
 status = "okay";

 eeprom: eeprom@5e {
  compatible = "atmel,at24", "atmel,24mac402";
  reg = <0x5e>;
  size = <256>;
  pagesize = <16>;
  address-width = <8>;
  timeout = <5>;

  nvmem-layout {
   compatible = "fixed-layout";
   #address-cells = <1>;
   #size-cells = <1>;

   mac_address: mac-address@9a {
    reg = <0x9a 6>;
    #nvmem-cell-cells = <0>;
   };
  };
 };
};

&sercom5 {
 compatible = "microchip,sercom-g1-uart";
 #address-cells = <1>;
 #size-cells = <0>;
 current-speed = <115200>;
 data-bits = <8>;
 parity = "none";
 stop-bits = "1";
 rxpo = <1>;
 txpo = <0>;
 pinctrl-0 = <&sercom5_uart_default>;
 pinctrl-names = "default";
 status = "okay";
};

&trng {
 status = "okay";
};

&can0 {
 pinctrl-0 = <&can0_default>;
 pinctrl-names = "default";
 status = "okay";
};

&sercom2 {
 compatible = "microchip,sercom-g1-spi";
 dipo = <3>;
 dopo = <0>;
 #address-cells = <1>;
 #size-cells = <0>;
