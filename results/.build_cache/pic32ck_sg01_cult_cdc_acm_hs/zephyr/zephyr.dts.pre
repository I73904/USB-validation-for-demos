 phy: ethernet-phy@0 {
  compatible = "ethernet-phy";
  status = "okay";
  reg = <0>;
 };
};

&sdhc0 {
 compatible = "microchip,sdhc-g1";
 pinctrl-0 = <&sdhc0_default>;
 pinctrl-names = "default";
 auto-cmd23;
